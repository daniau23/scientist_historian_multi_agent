# Copy this file to `.env` and fill in your own values.
# `.env` lives in the repository root and is read automatically (python-dotenv).
# Real environment variables always win over `.env`, so Modal secrets override
# these values in the deployment.

# --- Google Generative AI (Gemini) — REQUIRED for the CLI / local runs --------
# NOTE: the deployed app does NOT use this key. Each end user supplies their own
# key through the frontend (byok_gate), so the host never spends its quota.
GOOGLE_AI_STUDIO_GENERATIVE_MODEL_API_KEY="your-gemini-api-key"

# Optional model overrides (defaults shown):
GOOGLE_MODEL="gemini-2.5-flash"
GOOGLE_EVALUATOR_MODEL="gemini-3.7-flash"

# --- Tavily web search — only needed for *_tools workflows --------------------
# For the CLI / local runs. The deployed app does NOT use this key: users paste
# their own Tavily key in the sidebar (web search is skipped if they don't).
TAVILY_API_KEY="your-tavily-api-key"

# --- LangSmith tracing — optional ---------------------------------------------
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_PROJECT="scientist-workflows"
LANGSMITH_TRACING="true"

# --- Deployment frontend ------------------------------------------------------
# The deployed Modal POST endpoint (label `researcher-workflow`).
# Or set this in `.streamlit/secrets.toml` when deploying the Streamlit app.
MODAL_URL="https://<workspace>--researcher-workflow.modal.run"

# Set to 1/true to skip the online key check (accept user keys on format alone).
BYOK_SKIP_ONLINE_VERIFY="false"
